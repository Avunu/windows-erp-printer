#!/bin/sh
# Conventional Commits check (release-please builds the version and CHANGELOG.md from these).
# Enable once per clone:  git config core.hooksPath .githooks
script="$(git rev-parse --show-toplevel)/build/Test-CommitMessage.ps1"
if command -v pwsh >/dev/null 2>&1; then
    exec pwsh -NoProfile -File "$script" -Path "$1"
elif command -v powershell.exe >/dev/null 2>&1; then
    exec powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$script" -Path "$1"
else
    echo "commit-msg: PowerShell not found; skipping the commit message check." >&2
fi
