<Project Sdk="Microsoft.NET.Sdk">
  <!-- Everything that touches Windows: registry, DPAPI, the print spooler, named pipes with ACLs, event log, services. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>ErpPrinter.Windows</RootNamespace>
    <AssemblyName>ErpPrinter.Windows</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\ErpPrinter.Core\ErpPrinter.Core.csproj" />
    <InternalsVisibleTo Include="ErpPrinter.Windows.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.Diagnostics.EventLog" Version="10.0.13" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.13" />
    <PackageReference Include="System.Management" Version="10.0.13" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.13" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.13" />
  </ItemGroup>
</Project>
