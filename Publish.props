<Project>
  <!--
    Publish settings for the three executables that ship in the MSI (Service, Cli, Config), imported by
    Directory.Build.props. build/Publish-Dotnet.ps1 publishes each of them, self-contained for win-x64, into
    one shared folder that installer/ErpPrinter.Service.wxs then packs. The libraries are unaffected.

      dotnet publish (project) -c Release -r win-x64 (self-contained) -o (folder)

    Deliberately NOT done: trimming and Native AOT (the code relies on reflection-heavy APIs: JSON, WinForms,
    System.Management, hosting) and single-file bundling (the three exes share one copy of the runtime, so the
    folder is smaller and an in-place update replaces plain files).
  -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'ErpPrinter.Service' Or '$(MSBuildProjectName)' == 'ErpPrinter.Cli' Or '$(MSBuildProjectName)' == 'ErpPrinter.Config'">
    <IsErpPrinterApp>true</IsErpPrinterApp>
    <ApplicationIcon>$(MSBuildThisFileDirectory)assets\erp-printer.ico</ApplicationIcon>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishAot>false</PublishAot>
    <PublishSingleFile>false</PublishSingleFile>
    <!-- Product strings are not localised; skip the runtime's satellite resource folders for other languages. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- Only when a runtime is chosen (-r win-x64): a plain build or test run stays framework-dependent and fast. -->
  <PropertyGroup Condition="'$(IsErpPrinterApp)' == 'true' And '$(RuntimeIdentifier)' != ''">
    <SelfContained Condition="'$(SelfContained)' == ''">true</SelfContained>
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <!-- Keep line numbers in service stack traces without shipping separate .pdb files. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>embedded</DebugType>
  </PropertyGroup>
</Project>
