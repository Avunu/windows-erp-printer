<!-- Generated by build/New-PolicyTemplate.ps1 from the ErpPrinter settings schema. Do not edit by hand. -->
<policyDefinitionResources xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" revision="1.0" schemaVersion="1.0" xmlns="http://schemas.microsoft.com/GroupPolicy/2006/07/PolicyDefinitions">
  <displayName>ERP Printer</displayName>
  <description>Machine-wide settings for ERP Printer. Printer profiles are configured with Group Policy Preferences or Intune.</description>
  <resources>
    <stringTable>
      <string id="ErpPrinter">ERP Printer</string>
      <string id="SUPPORTED_ErpPrinter">ERP Printer 1.0 and later</string>
      <string id="Cat_Storage">Storage</string>
      <string id="Cat_Delivery">Delivery</string>
      <string id="Cat_Updates">Updates</string>
      <string id="DataRoot">Data folder</string>
      <string id="DataRoot_Help">Outbox, failed/sent archives, logs and downloaded updates are stored here. Locked to SYSTEM and Administrators.

If you do not configure this policy, the value set on the device (ERP Printer configuration window, installer or registry) is used. Built-in default: %ProgramData%\ErpPrinter.</string>
      <string id="PollIntervalSeconds">Poll interval (seconds)</string>
      <string id="PollIntervalSeconds_Help">How often the uploader re-scans the outbox. New print jobs wake it immediately.

If you do not configure this policy, the value set on the device (ERP Printer configuration window, installer or registry) is used. Built-in default: 15.</string>
      <string id="MaxAttempts">Max delivery attempts</string>
      <string id="MaxAttempts_Help">After this many failed attempts a document is moved to the failed folder. 0 retries forever.

If you do not configure this policy, the value set on the device (ERP Printer configuration window, installer or registry) is used. Built-in default: 0.</string>
      <string id="RetryMaxBackoffMinutes">Max retry backoff (minutes)</string>
      <string id="RetryMaxBackoffMinutes_Help">Retries back off exponentially from 30 seconds up to this ceiling.

If you do not configure this policy, the value set on the device (ERP Printer configuration window, installer or registry) is used. Built-in default: 60.</string>
      <string id="MaxDocumentSizeMB">Max document size (MB)</string>
      <string id="MaxDocumentSizeMB_Help">Larger documents are moved to the failed folder instead of being uploaded.

If you do not configure this policy, the value set on the device (ERP Printer configuration window, installer or registry) is used. Built-in default: 64.</string>
      <string id="HttpTimeoutSeconds">HTTP timeout (seconds)</string>
      <string id="HttpTimeoutSeconds_Help">HTTP timeout (seconds).

If you do not configure this policy, the value set on the device (ERP Printer configuration window, installer or registry) is used. Built-in default: 120.</string>
      <string id="ProxyUrl">Proxy URL</string>
      <string id="ProxyUrl_Help">Optional, e.g. http://proxy:8080. The service runs as SYSTEM and does not see per-user proxy settings.

If you do not configure this policy, the value set on the device (ERP Printer configuration window, installer or registry) is used. Built-in default: (empty).</string>
      <string id="KeepSentDays">Keep sent documents (days)</string>
      <string id="KeepSentDays_Help">0 deletes documents as soon as they are delivered.

If you do not configure this policy, the value set on the device (ERP Printer configuration window, installer or registry) is used. Built-in default: 0.</string>
      <string id="LogLevel">Log level</string>
      <string id="LogLevel_Help">Log level.

If you do not configure this policy, the value set on the device (ERP Printer configuration window, installer or registry) is used. Built-in default: Information.</string>
      <string id="LogLevel_Error">Error</string>
      <string id="LogLevel_Warning">Warning</string>
      <string id="LogLevel_Information">Information</string>
      <string id="LogLevel_Verbose">Verbose</string>
      <string id="LogRetentionDays">Keep logs (days)</string>
      <string id="LogRetentionDays_Help">Keep logs (days).

If you do not configure this policy, the value set on the device (ERP Printer configuration window, installer or registry) is used. Built-in default: 14.</string>
      <string id="AutoUpdate">Install updates automatically</string>
      <string id="AutoUpdate_Help">Install updates automatically.

If you do not configure this policy, the value set on the device (ERP Printer configuration window, installer or registry) is used. Built-in default: enabled.</string>
      <string id="UpdateManifestUrl">Update manifest URL</string>
      <string id="UpdateManifestUrl_Help">HTTPS URL or UNC path of latest.json. Defaults to the latest GitHub release of this project.

If you do not configure this policy, the value set on the device (ERP Printer configuration window, installer or registry) is used. Built-in default: latest.json of the latest release of this project.</string>
      <string id="RequireSignedUpdates">Require Authenticode-signed updates</string>
      <string id="RequireSignedUpdates_Help">Require Authenticode-signed updates.

If you do not configure this policy, the value set on the device (ERP Printer configuration window, installer or registry) is used. Built-in default: disabled.</string>
      <string id="UpdateSignerThumbprint">Update signer thumbprint</string>
      <string id="UpdateSignerThumbprint_Help">If set, update packages must be signed by this certificate.

If you do not configure this policy, the value set on the device (ERP Printer configuration window, installer or registry) is used. Built-in default: (empty).</string>
    </stringTable>
    <presentationTable>
      <presentation id="DataRoot"><textBox refId="DataRoot"><label>Data folder:</label></textBox></presentation>
      <presentation id="PollIntervalSeconds"><decimalTextBox refId="PollIntervalSeconds" defaultValue="15">Poll interval (seconds):</decimalTextBox></presentation>
      <presentation id="MaxAttempts"><decimalTextBox refId="MaxAttempts" defaultValue="0">Max delivery attempts:</decimalTextBox></presentation>
      <presentation id="RetryMaxBackoffMinutes"><decimalTextBox refId="RetryMaxBackoffMinutes" defaultValue="60">Max retry backoff (minutes):</decimalTextBox></presentation>
      <presentation id="MaxDocumentSizeMB"><decimalTextBox refId="MaxDocumentSizeMB" defaultValue="64">Max document size (MB):</decimalTextBox></presentation>
      <presentation id="HttpTimeoutSeconds"><decimalTextBox refId="HttpTimeoutSeconds" defaultValue="120">HTTP timeout (seconds):</decimalTextBox></presentation>
      <presentation id="ProxyUrl"><textBox refId="ProxyUrl"><label>Proxy URL:</label></textBox></presentation>
      <presentation id="KeepSentDays"><decimalTextBox refId="KeepSentDays" defaultValue="0">Keep sent documents (days):</decimalTextBox></presentation>
      <presentation id="LogLevel"><dropdownList refId="LogLevel" noSort="true" defaultItem="2">Log level:</dropdownList></presentation>
      <presentation id="LogRetentionDays"><decimalTextBox refId="LogRetentionDays" defaultValue="14">Keep logs (days):</decimalTextBox></presentation>
      <presentation id="UpdateManifestUrl"><textBox refId="UpdateManifestUrl"><label>Update manifest URL:</label></textBox></presentation>
      <presentation id="UpdateSignerThumbprint"><textBox refId="UpdateSignerThumbprint"><label>Update signer thumbprint:</label></textBox></presentation>
    </presentationTable>
  </resources>
</policyDefinitionResources>
